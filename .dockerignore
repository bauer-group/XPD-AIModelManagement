# NOTE: the `test` build stage runs pytest inside the image, and `uv sync --locked`
# needs the lockfile — so tests/ and uv.lock must NOT be excluded here.
.git
.gitignore
.gitattributes
.github

# Virtualenvs / caches (a host .venv breaks UV_LINK_MODE across filesystems)
.venv
venv
.uv
uv-cache
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Working data / secrets
/data
/staging
*.env
!.env.example

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Docs (README is needed: pyproject declares readme = "README.md")
*.md
!README.md
docs
