# EditorConfig — https://editorconfig.org
#
# Reinforces the LF policy from .gitattributes at the editor level, so a file is
# already correct before Git has to normalise it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

# Markdown: two trailing spaces are a hard line break, so trimming them changes
# the rendered output.
[*.{md,MD}]
trim_trailing_whitespace = false

# Make requires literal tabs in recipes. Spaces here produce
# "missing separator. Stop." and nothing else.
[Makefile]
indent_style = tab

[Make.cmd]
end_of_line = lf
indent_style = space
indent_size = 2
