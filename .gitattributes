# =============================================================================
# Line endings — LF everywhere, enforced by Git, not by hope.
# -----------------------------------------------------------------------------
# Development happens on Windows; CI, the MinIO rig and every consumer of the
# published wheel run on Linux. `eol=lf` makes Git store AND check out LF no
# matter what the contributor's core.autocrlf says, which is the only setting
# that survives a fresh clone on a new machine.
#
# This is not cosmetic. A CRLF checkout silently breaks:
#   - POSIX sh scripts        (`\r` becomes part of the last argument)
#   - YAML heredocs and the inline `content:` blocks in the compose rig
#   - the Makefile            (recipes end in `\r`; targets fail with no clue)
# All of those fail on the Linux side, long after the Windows side looked fine.
# =============================================================================

# Default: everything is text and is normalised to LF.
* text=auto eol=lf

# ── Source & config (must always be LF) ──────────────────────────────────────
*.py      text eol=lf
*.pyi     text eol=lf
*.sh      text eol=lf
*.bash    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.jsonc   text eol=lf
*.toml    text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.md      text eol=lf
*.MD      text eol=lf
*.txt     text eol=lf

# ── Dotfiles and extensionless files ─────────────────────────────────────────
.gitignore        text eol=lf
.gitattributes    text eol=lf
.editorconfig     text eol=lf
.markdownlint.jsonc text eol=lf
.gitleaks.toml    text eol=lf
Makefile          text eol=lf
CODEOWNERS        text eol=lf
LICENSE           text eol=lf

# Make.cmd is the Windows twin of the Makefile and is interpreted by cmd.exe.
# cmd.exe tolerates LF, and keeping it LF means the two twins diff cleanly
# against each other.
Make.cmd  text eol=lf

# ── Binary (never normalise, never diff) ─────────────────────────────────────
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.pdf     binary
*.gz      binary
*.tgz     binary
*.tar     binary
*.zip     binary
*.whl     binary
*.gpg     binary
# Model weights. They have no business in this repo, but if one ever lands here
# by accident it must not be line-ending-mangled on top of everything else.
*.safetensors binary
*.bin     binary
*.gguf    binary
*.onnx    binary
